# ===== dsh-aquasense 环境变量模板 =====
# 复制为 .env(或写入部署环境变量)后按需填写。
# 凭证类变量也可改用文档约定的配置文件方式(见 README)。

# --- 图像分析(aquasense_analyze,必填) ---
DEEPSEEK_API_KEY=sk-xxxxxxxx
# 视觉模型名,默认 deepseek-flash(Vision)
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- IMA 知识库(aquasense_advice 内置查询,必填) ---
# 方式 A:环境变量;方式 B:~/.config/ima/client_id + api_key(任选其一)
IMA_OPENAPI_CLIENTID=xxxxxxxx
IMA_OPENAPI_APIKEY=xxxxxxxx

# --- 飞书应用凭证(aquasense_ledger 与 S9 提醒,必填) ---
# 应用需具备:bitable:app、im:message 权限;开通为群机器人后填入群 chat_id 作为 FEISHU_WORKER_GROUP
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx

# --- 飞书多维表格(必填 app_token;至少配置巡检表,其余场景表按需) ---
FEISHU_BITABLE_APP_TOKEN=xxxxxxxx
FEISHU_BITABLE_TABLE_ID_INSPECTION=xxxxxxxx        # S2 巡检记录
FEISHU_BITABLE_TABLE_ID_WATER_QUALITY=xxxxxxxx     # S1 水质汇报(可选)
FEISHU_BITABLE_TABLE_ID_MEDICATION=xxxxxxxx        # S5 用药记录(可选)
FEISHU_BITABLE_TABLE_ID_FEEDING=xxxxxxxx           # S6 投喂记录(可选)
FEISHU_BITABLE_TABLE_ID_TEMPERATURE=xxxxxxxx       # S7 温度汇报(可选)
FEISHU_BITABLE_TABLE_ID_DEATH=xxxxxxxx             # S4 死亡记录(可选)
FEISHU_BITABLE_TABLE_ID_DISSECTION=xxxxxxxx        # S8 解剖记录(可选)

# --- S9 每日任务提醒(可选) ---
# 提醒推送目标(巡检群 chat_id)
FEISHU_WORKER_GROUP=oc_xxxxxxxx
# 任务清单与 PDF 正文缓存目录,默认 ./cache
AQUASENSE_CACHE_DIR=./cache
